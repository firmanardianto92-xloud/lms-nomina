# Salin ke backend/.env (atau set sebagai environment variable) — semua opsional untuk demo.
NOMINA_SECRET=ganti-dengan-string-acak-minimal-32-karakter
NOMINA_DB_URL=sqlite:///./nomina.db
NOMINA_TZ=Asia/Jakarta
NOMINA_AUTO_SEED=1
CORS_ORIGINS=http://localhost:5173

# --- Udemy Business (kosong = mode contoh dengan katalog contoh) ---
UDEMY_SUBDOMAIN=
UDEMY_ACCOUNT_ID=
UDEMY_CLIENT_ID=
UDEMY_CLIENT_SECRET=
# Shared secret untuk webhook xAPI real-time: POST /api/integrations/udemy/xapi (header X-Nomina-Webhook-Secret)
UDEMY_XAPI_SECRET=

# --- Coursera for Business (kosong = mode contoh) ---
COURSERA_ORG_ID=
COURSERA_PROGRAM_ID=
COURSERA_CLIENT_ID=
COURSERA_CLIENT_SECRET=

# --- Zoom (Server-to-Server OAuth app, scope meeting:write:admin) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_USER_ID=me

# --- Microsoft Teams (Azure AD app, permission OnlineMeetings.ReadWrite.All + Application Access Policy) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_ORGANIZER_ID=

# --- Google Meet (service account + domain-wide delegation, scope calendar.events) ---
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_IMPERSONATE=
